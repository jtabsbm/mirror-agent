# Copy to .env and fill in when the operator's key arrives.
# The app runs in DEMO mode until YOUCAM_API_KEY is set.

# Perfect Corp YouCam API key (https://yce.makeupar.com/api-console/en/api-keys/)
YOUCAM_API_KEY=

# Gemini (Google AI Studio) — powers the agent interpretation steps.
# Reuses the existing key from zero-cash-revenue-engine/.env if unset here.
GEMINI_API_KEY=

# Optional overrides
# YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
